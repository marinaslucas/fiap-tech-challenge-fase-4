# =====================================================================
# Template de variaveis de ambiente do medica-ia-multimodal.
# Copie para .env e preencha conforme cada servico for provisionado.
# Nunca commitar .env real (vide .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Azure Speech
# Provisione em: portal.azure.com -> Speech Services
# ---------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# ---------------------------------------------------------------------
# Azure Language
# Provisione em: portal.azure.com -> Language
# ---------------------------------------------------------------------
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=

# ---------------------------------------------------------------------
# Azure OpenAI
# Provisione em: ai.azure.com (Foundry) ou portal.azure.com -> Azure OpenAI
# Deployment esperado: gpt-4.1-mini
# ---------------------------------------------------------------------
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Modelo multimodal (audio input) p/ emocao vocal sem vies de RAVDESS.
# Deploy separado no Foundry, ex: gpt-4o-mini-audio-preview.
# Quando vazio, pilar de emocao vocal cai pra wav2vec2 local.
AZURE_OPENAI_AUDIO_DEPLOYMENT=
# Modelo multimodal (vision input) p/ emocao facial sem vies de FER-2013.
# Deploy separado no Foundry, ex: gpt-4o-mini ou gpt-4o.
# Quando vazio, pilar de emocao facial cai pra FER local.
AZURE_OPENAI_VISION_DEPLOYMENT=

# ---------------------------------------------------------------------
# Toggles cloud vs local
# Quando true, pipelines usam servicos Azure no lugar dos modelos locais.
# ---------------------------------------------------------------------
USE_CLOUD_TRANSCRIPTION=false

# ---------------------------------------------------------------------
# Caminhos de modelos e indices
# ---------------------------------------------------------------------
YOLO_WEIGHTS_PATH=models/yolov8n_surgical.pt
RAG_INDEX_PATH=data/processed/chroma

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
